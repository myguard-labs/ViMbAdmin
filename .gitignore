.buildpath
.project
.gitmodules
.settings/
*.DS_Store
application/configs/application.ini
application/configs/application.ini.old
public/.htaccess
var/log/[1-9]*
var/log/vimbadmin.log*
var/templates_c/[a-zA-Z0-9%]*
var/session/sess_*
var/tmp
# Doctrine proxies are generated build artifacts (bin/generate-proxies.php runs
# at image build). Do not commit them — they silently drift from the entities.
application/Proxies/__CG__*.php
*~
vendor/[a-zA-Z0-9]*
# Closure Compiler is a local build prerequisite for bin/minify-options.php,
# fetched per-machine rather than vendored (13MB binary).
bin/compiler.jar
# clean-css is the CSS minifier for bin/minify-options.php (the vendored
# yuicompressor.jar corrupts Bootstrap 5 CSS). Installed per-machine with
# `npm ci --prefix bin`; the manifest and lockfile are committed below.
bin/node_modules/
vimbadmin.sublime-project
vimbadmin.sublime-workspace
vimbadmin3.sublime-project
vimbadmin3.sublime-workspace

.idea
