<?xml version="1.0"?>
<psalm
    errorLevel="8"
    resolveFromConfigFile="true"
    findUnusedBaselineEntry="false"
    findUnusedCode="false"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    errorBaseline="psalm-taint-baseline.xml"
>
    <!--
        Psalm is configured only for interprocedural taint analysis. Its type
        and dead-code lenses are intentionally unused; PHPStan owns the type
        lens for this repository. Invoke Psalm's taint-analysis mode.
    -->
    <projectFiles>
        <file name="ci/test-refactor-doveadm-contract.php" />
        <file name="ci/test-archive-zero-destination-contract.php" />
        <file name="ci/test-maintenance-resource-claims.php" />
        <file name="ci/test-oss-genurl-components.php" />
        <file name="ci/test-entity-autoloader-registration.php" />
        <file name="ci/test-refactor-autoload-contract.php" />
        <file name="ci/test-maintenance-session-identity.php" />
        <file name="ci/support/maintenance-session-identity.php" />
        <file name="ci/patch-psalm-named-taint.php" />
        <file name="ci/patch-psalm-callable-taint.php" />
        <directory name="src" />
        <directory name="library" />
        <directory name="application" />
        <file name="public/index.php" />
        <directory name="bin" />
        <directory name="tools" />
        <file name="preload.php" />
        <file name="ci/test-nonstyle-rate-limit-cleanup-contract.php" />
        <file name="ci/test-cli-precompile-contract.php" />
        <file name="ci/test-cli-schema-result-contract.php" />
        <file name="ci/test-smarty-date-formatter-contract.php" />
        <file name="ci/test-smarty-filesize-contract.php" />
        <file name="ci/test-smarty-shorten-contract.php" />
        <file name="ci/test-smarty-unixdate-contract.php" />
        <!--
            Psalm honours only one ignoreFiles element; a second one is
            silently dropped. Keep every ignored directory in this block.
            Generated Doctrine proxies are gitignored and may be absent, so
            the block allows missing files.
        -->
        <ignoreFiles allowMissingFiles="true">
            <directory name="vendor" />
            <directory name="application/Proxies" />
        </ignoreFiles>
    </projectFiles>

    <!-- Optional client declarations are scanned only; Composer never loads them. -->
    <extraFiles>
        <directory name="var/tmp/psalm-optional/predis/src" />
    </extraFiles>
    <enableExtensions>
        <extension name="redis" />
    </enableExtensions>
    <stubs>
        <file name="ci/psalm-stubs/mcp-request-body.phpstub" />
        <file name="var/tmp/psalm-optional/redis/RedisArray.php" />
        <file name="var/tmp/psalm-optional/redis/RedisCluster.php" />
        <file name="var/tmp/psalm-optional/relay/AdaptiveCache.php" />
        <file name="var/tmp/psalm-optional/relay/Cluster.php" />
        <file name="var/tmp/psalm-optional/relay/Event.php" />
        <file name="var/tmp/psalm-optional/relay/Events.php" />
        <file name="var/tmp/psalm-optional/relay/Exception.php" />
        <file name="var/tmp/psalm-optional/relay/KeyType.php" />
        <file name="var/tmp/psalm-optional/relay/Relay.php" />
        <file name="var/tmp/psalm-optional/relay/Sentinel.php" />
        <file name="var/tmp/psalm-optional/relay/Table.php" />
    </stubs>

    <!--
        BruteForce.php's known TaintedFile reports are retained as exact code
        entries in psalm-taint-baseline.xml. Per-IP state filenames use
        hash('sha256', $ip); directory, lock, cursor and suffix components are
        trusted configuration or fixed literals. Do not add a file-wide issue
        handler here: it would hide a new sink before the drift check sees it.
    -->
</psalm>
