<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">

<head>
    <title>ViMbAdmin</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta http-equiv="Content-Language" content="en" />

    <meta name="description" content="ViMbAdmin" />
    <meta name="keywords" content="ViMbAdmin" />
    <meta name="author" content="www.opensolutions.ie" />
    <meta name="owner" content="www.opensolutions.ie" />
    <meta name="robots" content="index, follow" />

    <link rel="shortcut icon" type="image/x-icon" href="{genUrl}/favicon.ico" />
    <link rel="shortcut icon" type="image/ico" href="{genUrl}/favicon.ico" />
    <link rel="icon" type="image/x-icon" href="{genUrl}/favicon.ico" />

    {tmplinclude file='header-js.phtml'}
    {tmplinclude file='header-css.phtml'}

{if isset($inColorBox) && $inColorBox}
    <link rel="stylesheet" type="text/css" href="{genUrl}/css/930-popup.css" />
{/if}

    <!-- Le HTML5 shim, for IE6-8 support of HTML5 elements -->
    <!--[if lt IE 9]>
      <script src="//html5shim.googlecode.com/svn/trunk/html5.js"></script>
    <![endif]-->

</head>

<body>

{if !isset($inColorBox) || !$inColorBox}
    {* Bootstrap 5 navbar. `navbar-expand-lg` is what makes the collapse
       responsive: without it BS5 keeps `.navbar-collapse` hidden at every
       width, so the whole menu disappears. `navbar-dark bg-dark` replaces
       BS2's `navbar-inverse`, and `fixed-top` replaces `navbar-fixed-top`. *}
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
            <div class="container">
                <a class="navbar-brand" href="{genUrl}">ViMbAdmin{if not $hasIdentity} :: <em>Virtual Mailbox Administration</em>{/if}</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#vimbadmin-navbar" aria-controls="vimbadmin-navbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                    <div class="collapse navbar-collapse" id="vimbadmin-navbar">
                        {if $hasIdentity}
                            <ul class="navbar-nav">
                                <li class="nav-item">
                                    <a class="nav-link{if $controller eq 'domain'} active{/if}" href="{genUrl controller='domain'}">Domains</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link{if $controller == 'mailbox' || $controller == 'calendar'} active{/if}" href="{genUrl controller='mailbox'}">Mailboxes</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link{if $controller eq 'alias'} active{/if}" href="{genUrl controller='alias'}">Aliases</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link{if $controller eq 'archive'} active{/if}" href="{genUrl controller='archive'}">Archives</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link{if $controller eq 'log'} active{/if}" href="{genUrl controller='log'}">Logs</a>
                                </li>
                                {if $hasIdentity and $user->isSuper()}
                                    <li class="nav-item">
                                        <a class="nav-link{if $controller eq 'admin'} active{/if}" href="{genUrl controller='admin'}" >Administrators</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link{if $controller eq 'maintenance'} active{/if}" href="{genUrl controller='maintenance'}">Maintenance</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link{if $controller eq 'queue'} active{/if}" href="{genUrl controller='queue'}">Queue</a>
                                    </li>
                                {/if}

                                    {* <li class="nav-item">
                                        <a class="nav-link{if $controller == 'shared-calendar' && $module == "davical" } active{/if}" href="{genUrl module='davical' controller='shared-calendar'}">Shared Calendar</a>
                                    </li> *}

                                <li class="nav-item">
                                    <a class="nav-link" id="your_password" href="{genUrl controller='admin' action='password' aid=$user->getId()}">Password</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link{if $controller eq 'admin' && $action eq 'two-factor'} active{/if}" id="your_2fa" href="{genUrl controller='admin' action='two-factor'}">2FA</a>
                                </li>
                                 <li class="nav-item">
                                    <a class="nav-link{if $action eq 'about'} active{/if}" href="http://www.vimbadmin.net/" target="_blank">About</a>
                                </li>
                            </ul>
                            <ul class="navbar-nav ms-auto">
                                <li class="nav-item">
                                    <a class="nav-link" href="{genUrl controller='auth' action='logout'}">Logout</a>
                                </li>
                            </ul>
                        {else}
                            <ul class="navbar-nav">
                                <li class="nav-item">
                                    <a class="nav-link{if $action eq 'about'} active{/if}" href="http://www.vimbadmin.net/">About</a>
                                </li>
                            </ul>
                            <ul class="navbar-nav ms-auto">
                                <li class="nav-item">
                                    <a class="nav-link" href="{genUrl controller='auth' action='login'}">Login</a>
                                </li>
                            </ul>
                        {/if}

                    </div><!--/.navbar-collapse -->

            </div>
    </nav>
{/if}


<div class="container">
