{tmplinclude file="header.phtml"}

<div class="page-content" >

    <div class="page-header" >

        <div style="float: right; margin-top: -10px;">
            <div class="btn-toolbar">
            	<span class="btn-group">
        	        <a class="btn have-tooltip-below" id="add_admin"  title="Add Administrator" href="{genUrl controller='admin' action='add'}">
            	        <i class="bi-plus-lg"></i>
        	        </a>
            	</span>
        	</div>
    	</div>

        <h1>Administrators</h1>
    </div>

{OSS_Message}

<table id="list_table" cellpadding="0" cellspacing="0" border="0" class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Username</th>
            <th width="55">Active</th>
            <th width="55">Super</th>
            <th width="140">Last Login</th>
            <th width="115"></th>
        </tr>
    </thead>
    <tbody>
        {foreach $admins as $admin}
            <tr id="admin_{$admin->getId()}">
                <td>{$admin->getUsername()}</td>
                <td>
                    <div id="throb-toggle-active-{$admin->getId()}" style="float: right;"></div>
                    {if $identity.user->getId() != $admin->getId()}
                        <span id="toggle-active-{$admin->getId()}" data-toggle-active="{$admin->getId()}" class="btn btn-sm {if $admin->getActive()}btn-success{else}btn-danger{/if}">{$admin->getActive()|yesno}</span>
                    {else}
                        <span id="toggle-active-{$admin->getId()}" class="btn btn-sm disabled {if $admin->getActive()}btn-success{else}btn-danger{/if}">{$admin->getActive()|yesno}</span>
                    {/if}
                </td>
                <td>
                    <div id="throb-toggle-super-{$admin->getId()}" style="float: right;"></div>
                    {if $identity.user->getId() != $admin->getId()}
                        <span id="toggle-super-{$admin->getId()}" data-toggle-super="{$admin->getId()}" class="btn btn-sm super-toggle {if $admin->getSuper()}btn-success{else}btn-danger{/if}">{$admin->getSuper()|yesno}</span>
                    {else}
                        <span id="toggle-super-{$admin->getId()}" class="btn btn-sm disabled super-toggle {if $admin->getSuper()}btn-success{else}btn-danger{/if}">{$admin->getSuper()|yesno}</span>
                    {/if}
                </td>
                <td>
                    {if $admin->getLastLogin()}{$admin->getLastLogin()|date_format:"%Y-%m-%d %H:%M"}{else}<span class="muted">never</span>{/if}
                </td>
                <td>
                    <div class="btn-group">
                        <a class="btn btn-sm have-tooltip" id="password-{$admin->getId()}" title="Password" href="{genUrl controller='admin' action='password' aid=$admin->getId()}">
                            <i class="bi-lock"></i>
                        </a>
                        {if $user->isSuper() && $admin->getId() != $user->getId()}
                        <a class="btn btn-sm have-tooltip" id="admin_2fa_{$admin->getId()}" title="Manage two-factor" href="{genUrl controller='admin' action='manage-two-factor' aid=$admin->getId()}">
                            <i class="bi-qr-code"></i>
                        </a>
                        {/if}
                        <a class="btn btn-sm have-tooltip" id="admin_logs_{$admin->getId()}" title="Logs" href="{genUrl controller='log' action='list' aid=$admin->getId()}">
                            <i class="bi-list-ul"></i>
                        </a>

                        {if $identity.user->getId() != $admin->getId() }
                            <a class="btn btn-sm have-tooltip {if $admin->isSuper()}d-none{/if}" id="admin_domains_{$admin->getId()}" title="List Domains" href="{genUrl controller='admin' action='domains' aid=$admin->getId()}">
                                <i class="bi-display"></i>
                            </a>
                            <form method="post" action="{genUrl controller='admin' action='purge'}" class="purge-admin-form" style="display: inline;">
                                <input type="hidden" name="aid" value="{$admin->getId()}" />
                                <input type="hidden" name="csrf" value="{$csrfToken|escape}" />
                                <button class="btn btn-sm have-tooltip" id="purge-admin-{$admin->getId()}" title="Purge" ref="{$admin->getUsername()}" type="submit">
                                    <i class="bi-trash"></i>
                                </button>
                            </form>
                        {/if}

                    </div>
                </td>
            </tr>
        {/foreach}
    </tbody>
</table>


<div id="purge_dialog" class="modal fade" tabindex="-1" aria-labelledby="purge_dialog_label" aria-hidden="true">


    <div class="modal-dialog modal-dialog-centered">


        <div class="modal-content">

            <div class="modal-header">
                <h3 class="modal-title" id="purge_dialog_label">Are you sure?</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to purge <em id="purge_admin_name"></em> ?
                <br /><br />
                All logs and domain associations will be removed. If you simply want to
                close the user's account, deactivate it instead.
                <br /><br />
            </div>
            <div id="pdfooter" class="modal-footer">
                <a class="btn btn-danger" id="purge_dialog_delete" href="#">Purge</a>
                <button id="purge_dialog_cancel" class="btn">Cancel</button>
            </div>


        </div>


    </div>
</div>

<script type="text/javascript" nonce="{$cspNonce}">{tmplinclude file='admin/js/list.js'}</script>
<br />
</div>
{tmplinclude file="footer.phtml"}
