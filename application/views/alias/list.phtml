{tmplinclude file="header.phtml"}

{if isset( $session->domain ) && $session->domain }
    {assign var=domain value=$session->domain}
{/if}

<div class="page-content" >

    <div class="page-header" >

        <div style="float: right; margin-top: -10px;">
            <div class="btn-toolbar">
                    <span class="btn-group">
                    {if $ima}   
                        <a class="btn have-tooltip-below" id="ima" title="Hide Mailbox Aliases" href="{genUrl controller='alias' action='list' ima=0}{if isset( $domain ) && $domain}/did/{$domain->getId()}{/if}" >
            	            <i class="bi-eye"></i>
                        </a>
                    {else}
                        <a class="btn have-tooltip-below" id="ima" title="Show Mailbox Aliases" href="{genUrl controller='alias' action='list' ima=1}{if isset( $domain ) && $domain}/did/{$domain->getId()}{/if}" >
                            <i class="bi-eye-slash"></i>
                        </a>
                    {/if}
        	        <a class="btn have-tooltip-below" id="add_alias" title="Add Alias" href="{genUrl controller='alias' action='add'}{if isset( $domain ) && $domain}/did/{$domain->getId()}{/if}">

            	        <i class="bi-plus-lg"></i>
        	        </a>
            	</span>
        	</div>

    	</div>

        <h1>
            Aliases {if isset( $domain ) && $domain }<small> for {$domain->requiredDomainName()} {if $domain->getMaxAliases() != 0}({$domain->getAliasCount()}/{$domain->getMaxAliases()}){/if}</small>
                <a class="btn have-tooltip-below" id="show_all_aliases" title="Show All" href="{genUrl controller='alias' action='list' unset=1}{if $ima}/ima/1{/if}"><i class="bi-x-circle"></i></a>
            {/if}
        </h1>
    </div>

{OSS_Message}

<br/>

<table id="list_table" cellpadding="0" cellspacing="0" border="0" class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Address</th>
            <th>Domain</th>
            <th width="55">Active</th>
            <th>Goto</th>
            <th width="60"></th>
        </tr>
    </thead>
    <tbody>
    {foreach $aliases as $alias}
        <tr id="alias_{$alias.id}">
            <td>{$alias.address}</td>
            <td>{$alias.domain}</td>
            <td>
                <div id="throb-toggle-active-{$alias.id}" style="float: right;"></div>
                <span id="toggle-active-{$alias.id}" data-toggle-active="{$alias.id}" class="btn btn-sm {if $alias.active}btn-success{else}btn-danger{/if}">{$alias.active|yesno}</span>
            </td>
            <td>
                <div id="alias-goto-{$alias.id}" {if $alias.goto|strlen > 50 } title="{$alias.goto|regex_replace:"/[,]/":", "}"{/if}>
                {$alias.goto|shorten:50}
                </div>
            </td>
            <td>
                <div class="btn-group">
                    <a class="btn btn-sm have-tooltip" id="edit_alias_{$alias.id}" title="Edit" href="{genUrl controller='alias' action='edit' alid=$alias.id}">
                        <i class="bi-pencil"></i>
                    </a>
                    {if isset( $alias_actions ) }
                        {assign var=oid value=$alias.id}
                        {foreach $alias_actions as $action}
                            {if isset( $action.menu ) }
                                {assign var="action_list_menu" value=$action}
                            {else}
                                <{$action.tagName} {foreach $action as $attrib => $value}{if !$attrib|in_array:[ "tagName", "child"]}{$attrib}="{$value|replace:'%id%':$oid}" {/if}{/foreach}>
                                {if !$action.child|is_array }
                                    {$action.child}
                                {else}
                                    <{$action.child.tagName} {foreach $action.child as $attrib => $value}{if $attrib != "tagName"}{$attrib}="{$value}" {/if}{/foreach} {if $action.child.tagName != "img"}></{$action.child.tagName}>{else}/>{/if}
                                {/if}
                                </{$action.tagName}>
                            {/if}
                        {/foreach}
                    {/if}
                    <form method="post" action="{genUrl controller='alias' action='delete'}" class="delete-alias-form" style="display: inline;">
                        <input type="hidden" name="alid" value="{$alias.id}" />
                        <input type="hidden" name="csrf" value="{$csrfToken|escape}" />
                        <button class="btn btn-sm have-tooltip" id="delete-alias-{$alias.id}" title="Delete" type="submit">
                            <i class="bi-trash"></i>
                        </button>
                    </form>
                    {if isset( $action_list_menu)}
                        {assign var="action" value=$action_list_menu}
                        <{$action.tagName} {foreach $action as $attrib => $value}{if !$attrib|in_array:[ "tagName", "child", "menu" ]}{$attrib}="{$value|replace:'%id%':$oid}" {/if}{/foreach}>
                        {if !$action.child|is_array }
                            {$action.child}
                        {else}
                            <{$action.child.tagName} {foreach $action.child as $attrib => $value}{if $attrib != "tagName"}{$attrib}="{$value}" {/if}{/foreach} {if $action.child.tagName != "img"}></{$action.child.tagName}>{else}/>{/if}
                        {/if}
                        <span class="caret"></span>
                        </{$action.tagName}>
                        <ul class="dropdown-menu dropdown-menu-end">
                        {foreach $action.menu as $item}
                            <li><a {if isset( $item.id)}id="{$item.id|replace:'%id%':$oid}" {/if}href="{$item.url|replace:'%id%':$oid}">{$item.text}</a></li>
                        {/foreach}
                        </ul>
                    {/if}
                </div>
            </td>
        </tr>
    {/foreach}
    </tbody>
</table>

<br />
<br />
<br />

<script type="text/javascript" nonce="{$cspNonce}">{tmplinclude file='alias/js/list.js'}</script>

{tmplinclude file='list/_purge-modal-header.phtml'}            <div class="modal-body">
                Are you sure you want to delete this alias?
            </div>
            <div id="pdfooter" class="modal-footer">
                <a class="btn btn-danger" id="purge_dialog_delete" href="#">Delete</a>
                <button id="purge_dialog_cancel" class="btn">Cancel</button>
            </div>

        </div>

    </div>
</div>

</div>
{tmplinclude file="footer.phtml"}
